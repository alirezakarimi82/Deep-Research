# Deep Research — local secrets template
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored. Never commit it with live keys.
#
# Resolution order (highest → lowest):
#   1. Shell environment variables  (always win)
#   2. This .env file               (loaded by config.py via python-dotenv)
#   3. config.yaml                  (non-secret tuning only)
#   4. Hard-coded defaults
#
# All three variables are optional; the pipeline works without them
# but rate limits and features improve with each one configured.

# Polite-pool access for Unpaywall (100k OA PDF lookups/day).
# No registration needed — just your email address.
UNPAYWALL_EMAIL=your.email@example.com

# Semantic Scholar API key — raises rate limit from 100 req/5min to 10k req/min.
# Get one at: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_KEY=your_semantic_scholar_key_here

# OpenAlex API key — unlocks semantic (embedding) search and full-text PDF
# access via content.openalex.org.
# Register at: https://openalex.org/api-key
OPENALEX_API_KEY=your_openalex_api_key_here
