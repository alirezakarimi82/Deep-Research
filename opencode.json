{
  "$schema": "https://opencode.ai/config.json",

  "permission": {
    "skill": {
      "*": "allow"
    }
  },

  "mcp": {
    "alphaxiv": {
      "type": "remote",
      "url": "https://api.alphaxiv.org/mcp/v1"
    },
    "ddgs": {
      "type": "local",
      "command": ["ddgs", "mcp"]
    },
    "deep-research": {
      "type": "local",
      "command": ["python", "mcp_server.py"]
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--headless"],
      "enabled": true
    }
  }
}
